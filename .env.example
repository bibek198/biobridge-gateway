# Copy this file to .env (which git ignores) and fill in your own values. Never commit .env.
#
# Used by the Paper 2 descriptor-synthesis runner (app: `SYNTH_LIVE=1 npm run eval:synth`).
# Get a key at https://platform.claude.com/ . Alternatively run `ant auth login` and leave this unset.
# Keep the line commented out until you have a key: an empty value would override other credentials.
# ANTHROPIC_API_KEY=sk-ant-...
