{
  "schema": "biobridge.descriptor/v1",
  "id": "biobridge-node-b",
  "name": "BioBridge Node B (PPG, BLE)",
  "description": "ESP32 + MAX30102 red/IR PPG at 100 Hz. One BioBridge frame per BLE notification on a custom GATT service; samples are raw 18-bit ADC counts.",
  "transport": {
    "kind": "ble",
    "service": "6b1e0001-b19b-4b1d-9e0a-0b1b2d3c4e5f",
    "characteristic": "6b1e0002-b19b-4b1d-9e0a-0b1b2d3c4e5f",
    "namePrefix": "BioBridge-B"
  },
  "framing": {
    "kind": "magic-length-crc",
    "magic": [177, 11],
    "lengthOffset": 10,
    "lengthType": "u8",
    "headerLength": 11,
    "crc": { "kind": "crc16-ccitt-false", "start": 2, "endian": "le" },
    "maxFrameLength": 268
  },
  "messages": [
    {
      "name": "hello",
      "match": [
        { "offset": 3, "type": "u8", "equals": 1 }
      ],
      "info": true,
      "fields": [
        { "kind": "scalar", "offset": 11, "type": "u8", "channel": "protocol" },
        { "kind": "scalar", "offset": 12, "type": "u8", "channel": "nodeKind" },
        { "kind": "scalar", "offset": 13, "type": "u16le", "channel": "sampleRateHz" },
        { "kind": "scalar", "offset": 15, "type": "u8", "channel": "fwMajor" },
        { "kind": "scalar", "offset": 16, "type": "u8", "channel": "fwMinor" },
        { "kind": "hex", "offset": 17, "length": 6, "channel": "mac" }
      ]
    },
    {
      "name": "samples",
      "match": [
        { "offset": 3, "type": "u8", "equals": 2 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "send" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        {
          "kind": "samples",
          "offset": 14,
          "type": "u24le",
          "stride": 6,
          "count": { "offset": 11, "type": "u8" },
          "periodUs": { "offset": 12, "type": "u16le" },
          "channel": "ppg_red",
          "unit": "counts"
        },
        {
          "kind": "samples",
          "offset": 17,
          "type": "u24le",
          "stride": 6,
          "count": { "offset": 11, "type": "u8" },
          "periodUs": { "offset": 12, "type": "u16le" },
          "channel": "ppg_ir",
          "unit": "counts"
        }
      ]
    },
    {
      "name": "syncEvent",
      "match": [
        { "offset": 3, "type": "u8", "equals": 3 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "event" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 11, "type": "u8", "channel": "syncEvent" }
      ]
    },
    {
      "name": "timeProbe",
      "match": [
        { "offset": 3, "type": "u8", "equals": 5 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "send" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": []
    }
  ],
  "channels": [
    { "id": "ppg_ir", "label": "PPG (IR)", "unit": "counts", "display": "waveform" },
    { "id": "ppg_red", "label": "PPG (red)", "unit": "counts", "display": "waveform" },
    { "id": "syncEvent", "label": "Sync pulse edge", "display": "hidden" }
  ],
  "plausibility": {
    "ppg_ir": { "min": 0, "max": 262143 },
    "ppg_red": { "min": 0, "max": 262143 }
  }
}
