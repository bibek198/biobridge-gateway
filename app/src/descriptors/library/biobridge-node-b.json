{
  "schema": "biobridge.descriptor/v1",
  "id": "biobridge-node-b",
  "name": "BioBridge Node B (PPG, BLE)",
  "description": "ESP32 + MAX30102 red/IR PPG at 100 Hz. One BioBridge frame per BLE notification on a custom GATT service; samples are raw 18-bit ADC counts. Supports compute placement: raw samples, on-device PPG processing (pulse rate, SpO2, signal quality), SQI-gated raw, or both.",
  "transport": {
    "kind": "ble",
    "service": "6b1e0001-b19b-4b1d-9e0a-0b1b2d3c4e5f",
    "characteristic": "6b1e0002-b19b-4b1d-9e0a-0b1b2d3c4e5f",
    "namePrefix": "BioBridge-B",
    "commandCharacteristic": "6b1e0003-b19b-4b1d-9e0a-0b1b2d3c4e5f"
  },
  "framing": {
    "kind": "magic-length-crc",
    "magic": [177, 11],
    "lengthOffset": 10,
    "lengthType": "u8",
    "headerLength": 11,
    "crc": { "kind": "crc16-ccitt-false", "start": 2, "endian": "le" },
    "maxFrameLength": 268
  },
  "messages": [
    {
      "name": "hello",
      "match": [
        { "offset": 3, "type": "u8", "equals": 1 }
      ],
      "info": true,
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 11, "type": "u8", "channel": "protocol" },
        { "kind": "scalar", "offset": 12, "type": "u8", "channel": "nodeKind" },
        { "kind": "scalar", "offset": 13, "type": "u16le", "channel": "sampleRateHz" },
        { "kind": "scalar", "offset": 15, "type": "u8", "channel": "fwMajor" },
        { "kind": "scalar", "offset": 16, "type": "u8", "channel": "fwMinor" },
        { "kind": "hex", "offset": 17, "length": 6, "channel": "mac" }
      ]
    },
    {
      "name": "samples",
      "match": [
        { "offset": 3, "type": "u8", "equals": 2 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "send" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        {
          "kind": "samples",
          "offset": 14,
          "type": "u24le",
          "stride": 6,
          "count": { "offset": 11, "type": "u8" },
          "periodUs": { "offset": 12, "type": "u16le" },
          "channel": "ppg_red",
          "unit": "counts"
        },
        {
          "kind": "samples",
          "offset": 17,
          "type": "u24le",
          "stride": 6,
          "count": { "offset": 11, "type": "u8" },
          "periodUs": { "offset": 12, "type": "u16le" },
          "channel": "ppg_ir",
          "unit": "counts"
        }
      ]
    },
    {
      "name": "syncEvent",
      "match": [
        { "offset": 3, "type": "u8", "equals": 3 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "event" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 11, "type": "u8", "channel": "syncEvent" }
      ]
    },
    {
      "name": "timeProbe",
      "match": [
        { "offset": 3, "type": "u8", "equals": 5 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "send" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": []
    },
    {
      "name": "pulseEdge",
      "match": [
        { "offset": 3, "type": "u8", "equals": 6 },
        { "offset": 11, "type": "u8", "equals": 3 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "event" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 12, "type": "f32le", "channel": "pulse_edge" }
      ]
    },
    {
      "name": "pulseRateEdge",
      "match": [
        { "offset": 3, "type": "u8", "equals": 6 },
        { "offset": 11, "type": "u8", "equals": 4 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "event" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 12, "type": "f32le", "channel": "pulseRate_edge", "unit": "bpm" }
      ]
    },
    {
      "name": "spo2Edge",
      "match": [
        { "offset": 3, "type": "u8", "equals": 6 },
        { "offset": 11, "type": "u8", "equals": 5 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "event" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 12, "type": "f32le", "channel": "spo2_edge", "unit": "%" }
      ]
    },
    {
      "name": "sqiEdge",
      "match": [
        { "offset": 3, "type": "u8", "equals": 6 },
        { "offset": 11, "type": "u8", "equals": 6 }
      ],
      "timestamp": { "offset": 6, "type": "u32le", "unit": "us", "sentAt": "event" },
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 12, "type": "f32le", "channel": "sqi_edge" }
      ]
    },
    {
      "name": "stats",
      "match": [
        { "offset": 3, "type": "u8", "equals": 7 }
      ],
      "info": true,
      "seq": { "offset": 4, "type": "u16le" },
      "fields": [
        { "kind": "scalar", "offset": 11, "type": "u8", "channel": "mode" },
        { "kind": "scalar", "offset": 12, "type": "u32le", "channel": "dspUs" },
        { "kind": "scalar", "offset": 16, "type": "u32le", "channel": "txBytes" },
        { "kind": "scalar", "offset": 20, "type": "u16le", "channel": "statsPeriodMs" }
      ]
    }
  ],
  "channels": [
    { "id": "ppg_ir", "label": "PPG (IR)", "unit": "counts", "display": "waveform" },
    { "id": "ppg_red", "label": "PPG (red)", "unit": "counts", "display": "waveform" },
    { "id": "syncEvent", "label": "Sync pulse edge", "display": "hidden" },
    {
      "id": "pulseRate_edge",
      "label": "Pulse Rate (computed on device)",
      "unit": "bpm",
      "display": "scalar"
    },
    { "id": "spo2_edge", "label": "SpO2 (computed on device)", "unit": "%", "display": "scalar" },
    { "id": "sqi_edge", "label": "Signal quality (device)", "display": "scalar" },
    { "id": "pulse_edge", "label": "Pulse (device)", "display": "hidden" }
  ],
  "plausibility": {
    "ppg_ir": { "min": 0, "max": 262143 },
    "ppg_red": { "min": 0, "max": 262143 },
    "spo2_edge": { "min": 0, "max": 100 },
    "sqi_edge": { "min": 0, "max": 1 },
    "pulseRate_edge": { "min": 25, "max": 250 }
  },
  "commands": [
    {
      "id": "mode-raw",
      "label": "Raw: compute in the browser",
      "description": "Stream samples; the device runs no DSP.",
      "hex": "b10b01100000000000000100b3ee"
    },
    {
      "id": "mode-edge",
      "label": "Edge: compute on the device",
      "description": "The device runs the DSP and sends only results; no samples.",
      "hex": "b10b0110000000000000010192fe"
    },
    {
      "id": "mode-gated",
      "label": "Gated: results, raw only when needed",
      "description": "Results always; samples only while signal quality (SQI) is below 0.8, e.g. during motion.",
      "hex": "b10b01100000000000000102f1ce"
    },
    {
      "id": "mode-both",
      "label": "Both: samples and device results",
      "description": "For comparing device and browser on the same data.",
      "hex": "b10b01100000000000000103d0de"
    }
  ]
}
